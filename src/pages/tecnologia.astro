---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SubjectSection from '@/components/SubjectSection.astro';
import resources from '@/data/resources.json';

const { title, description, subjects } = resources.tecnologia;
---

<BaseLayout title={title} description={description}>
  <div class="max-w-6xl mx-auto px-4 py-12">

    <!-- Cabeçalho -->
    <header class="mb-10">
      <p class="text-green-600 text-sm font-semibold uppercase tracking-wide mb-1">Recursos</p>
      <h1 class="text-3xl font-bold text-gray-900 mb-3">{title}</h1>
      <p class="text-gray-600 max-w-2xl">{description}</p>
    </header>

    <!-- Navegação por âncora -->
    <nav class="flex flex-wrap gap-2 mb-12" aria-label="Ir para tema">
      {subjects.map(({ id, emoji, title }) => (
        <a
          href={`#${id}`}
          class="flex items-center gap-1.5 text-sm px-3 py-1.5 rounded-full border border-gray-200 hover:border-green-400 hover:text-green-700 transition-colors text-gray-600"
        >
          <span aria-hidden="true">{emoji}</span>
          {title}
        </a>
      ))}
    </nav>

    <!-- Seções por tema -->
    <div class="flex flex-col gap-14">
      {subjects.map((subject) => (
        <SubjectSection {...subject} />
      ))}
    </div>

  </div>
</BaseLayout>
