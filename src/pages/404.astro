---
import BaseLayout from '@/layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Página não encontrada"
  description="A página que você procura não existe ou foi movida."
  noindex={true}
>
  <div class="max-w-2xl mx-auto px-4 py-24 text-center">
    <span class="text-7xl mb-6 inline-block" aria-hidden="true">🔍</span>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-4">
      Página não encontrada
    </h1>
    <p class="text-gray-500 text-base sm:text-lg mb-8 leading-relaxed">
      A página que você procura não existe, foi movida ou o endereço foi digitado incorretamente.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <a
        href={`${base}/`}
        class="inline-flex items-center gap-2 bg-primary-600 text-white text-sm font-semibold px-5 py-3 rounded-xl hover:bg-primary-700 transition-colors shadow-sm"
      >
        🏠 Ir para o início
      </a>
      <a
        href={`${base}/guias`}
        class="inline-flex items-center gap-2 bg-white border border-gray-200 text-gray-700 text-sm font-semibold px-5 py-3 rounded-xl hover:border-primary-400 hover:text-primary-700 transition-colors"
      >
        📖 Ver guias
      </a>
    </div>
  </div>
</BaseLayout>
