---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import GuiaCard from '@/components/GuiaCard.astro';

const allGuias = await getCollection('guias');

const guias = allGuias.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const categories = [
  { value: 'todos',      label: 'Todos'      },
  { value: 'educacao',   label: 'Educação'   },
  { value: 'tecnologia', label: 'Tecnologia' },
  { value: 'dicas',      label: 'Dicas'      },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Guias"
  description="Guias práticos para estudar melhor, usar plataformas educacionais e navegar com segurança na internet."
>

  <div class="max-w-5xl mx-auto px-4 py-10">

    <header class="mb-8">
      <h1 class="text-3xl font-extrabold text-gray-900 mb-2">📖 Guias</h1>
      <p class="text-gray-500 text-base leading-relaxed max-w-2xl">
        Artigos práticos para te ajudar a estudar melhor, aproveitar as plataformas
        educacionais e navegar com segurança na internet.
      </p>
    </header>

    <nav
      id="category-nav"
      class="flex flex-wrap gap-2 mb-8"
      aria-label="Filtrar guias por categoria"
    >
      {categories.map(({ value, label }) => (
        <button
          type="button"
          data-category={value}
          class:list={[
            'text-sm px-4 py-1.5 rounded-full border font-medium transition-colors',
            value === 'todos'
              ? 'bg-primary-600 text-white border-primary-600'
              : 'bg-white text-gray-600 border-gray-300 hover:border-primary-400 hover:text-primary-700',
          ]}
          aria-pressed={value === 'todos' ? 'true' : 'false'}
        >
          {label}
        </button>
      ))}
    </nav>

    <div
      id="guias-grid"
      class="grid grid-cols-1 sm:grid-cols-2 gap-4"
      aria-live="polite"
      aria-label="Lista de guias"
    >
      {guias.map((guia) => (
        <div data-card-category={guia.data.category}>
          <GuiaCard slug={guia.slug} {...guia.data} />
        </div>
      ))}
    </div>

    <p
      id="empty-state"
      class="hidden text-center text-gray-400 py-16 text-sm"
      role="status"
    >
      Nenhum guia encontrado nesta categoria.
    </p>

  </div>

</BaseLayout>

<script>
  const VALID_CATEGORIES = new Set(['todos', 'educacao', 'tecnologia', 'dicas']);

  const nav   = document.getElementById('category-nav');
  const cards = document.querySelectorAll<HTMLElement>('[data-card-category]');
  const empty = document.getElementById('empty-state');
  const grid  = document.getElementById('guias-grid');

  nav?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-category]');
    if (!btn) return;

    const raw      = btn.dataset.category ?? '';
    const selected = VALID_CATEGORIES.has(raw) ? raw : 'todos';

    // Atualiza botões
    nav.querySelectorAll<HTMLButtonElement>('[data-category]').forEach((b) => {
      const active = b.dataset.category === selected;
      b.setAttribute('aria-pressed', String(active));
      b.classList.toggle('bg-primary-600',   active);
      b.classList.toggle('text-white',       active);
      b.classList.toggle('border-primary-600', active);
      b.classList.toggle('bg-white',         !active);
      b.classList.toggle('text-gray-600',    !active);
      b.classList.toggle('border-gray-300',  !active);
    });

    // Mostra/oculta cards
    let visible = 0;
    cards.forEach((card) => {
      const show = selected === 'todos' || card.dataset.cardCategory === selected;
      card.hidden = !show;
      if (show) visible++;
    });

    empty?.classList.toggle('hidden', visible > 0);
    grid?.classList.toggle('hidden',  visible === 0);
  });
</script>
