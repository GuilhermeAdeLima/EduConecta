    ---
import BaseLayout from '@/layouts/BaseLayout.astro';

const values = [
  {
    emoji: '🆓',
    title: 'Sempre gratuito',
    description:
      'Nenhum conteúdo aqui vai te pedir dinheiro, assinatura ou cartão de crédito. Educação de qualidade não deve ter preço.',
  },
  {
    emoji: '🔒',
    title: 'Sem cadastro',
    description:
      'Você não precisa criar conta, fornecer e-mail ou qualquer dado pessoal para acessar o conteúdo.',
  },
  {
    emoji: '📱',
    title: 'Funciona em qualquer tela',
    description:
      'Desenvolvido pensando primeiro no celular — o dispositivo mais comum entre estudantes com acesso limitado à internet.',
  },
  {
    emoji: '♿',
    title: 'Acessível',
    description:
      'Seguimos boas práticas de acessibilidade web para que o conteúdo funcione bem para o maior número possível de pessoas.',
  },
  {
    emoji: '⚡',
    title: 'Rápido e leve',
    description:
      'Páginas estáticas, sem rastreadores e sem scripts desnecessários. Carrega bem mesmo em conexões lentas.',
  },
  {
    emoji: '🌐',
    title: 'Código aberto',
    description:
      'O código-fonte é público. Qualquer pessoa pode estudar, sugerir melhorias ou contribuir diretamente pelo GitHub.',
  },
];

const selectionCriteria = [
  'O recurso é genuinamente gratuito e acessível sem cadastro obrigatório',
  'O conteúdo é em português brasileiro ou possui legendas em português',
  'A fonte é confiável — canal oficial, instituição reconhecida ou criador estabelecido',
  'O material é adequado para estudantes do ensino básico ou jovens em geral',
  'O recurso está ativo e atualizado',
];

const contribute = [
  { emoji: '🔗', action: 'Sugerir um recurso ou canal educacional' },
  { emoji: '✏️', action: 'Corrigir um erro ou informação desatualizada' },
  { emoji: '📝', action: 'Propor ou escrever um novo guia' },
  { emoji: '🐛', action: 'Reportar um problema técnico no site' },
  { emoji: '🌍', action: 'Traduzir ou adaptar conteúdo' },
];
---

<BaseLayout
  title="Sobre"
  description="Conheça o EduConecta — um projeto de código aberto que reúne recursos educacionais gratuitos para estudantes brasileiros."
>
  <div class="max-w-3xl mx-auto px-4 py-12">

    <!-- ============================================================
         CABEÇALHO
    ============================================================ -->
    <header class="mb-12 text-center">
      <span class="text-5xl mb-4 inline-block" aria-hidden="true">🎓</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-4">
        Sobre o EduConecta
      </h1>
      <p class="text-gray-600 text-base sm:text-lg leading-relaxed max-w-xl mx-auto">
        Um projeto de código aberto criado para facilitar o acesso à educação
        gratuita e de qualidade para estudantes brasileiros.
      </p>
    </header>

    <!-- ============================================================
         MISSÃO
    ============================================================ -->
    <section class="mb-14" aria-labelledby="missao-title">
      <h2 id="missao-title" class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2">
        <span aria-hidden="true">🎯</span> Nossa missão
      </h2>
      <div class="prose prose-gray prose-sm sm:prose-base max-w-none
                  prose-a:text-primary-600 prose-headings:text-gray-900">
        <p>
          O EduConecta nasceu de uma constatação simples: existem <strong>recursos educacionais excelentes e gratuitos</strong>
          espalhados pela internet — canais no YouTube, plataformas de cursos, ferramentas de estudo —
          mas encontrá-los exige tempo, acesso estável e saber onde procurar.
        </p>
        <p>
          Nossa missão é <strong>reunir, organizar e apresentar</strong> esses recursos de forma clara,
          acessível e sem burocracia, priorizando estudantes do ensino básico e jovens com
          acesso limitado a recursos educacionais de qualidade.
        </p>
        <p>
          Não produzimos conteúdo próprio — somos um <strong>ponto de partida</strong> que conecta
          você aos melhores materiais já disponíveis gratuitamente na internet.
        </p>
      </div>
    </section>

    <!-- ============================================================
         VALORES
    ============================================================ -->
    <section class="mb-14" aria-labelledby="valores-title">
      <h2 id="valores-title" class="text-xl font-bold text-gray-900 mb-6 flex items-center gap-2">
        <span aria-hidden="true">💡</span> Nossos princípios
      </h2>
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4" role="list">
        {values.map(({ emoji, title, description }) => (
          <li class="flex flex-col gap-2 p-4 bg-white border border-gray-200 rounded-2xl hover:border-primary-300 hover:shadow-sm transition-all">
            <span class="text-2xl" aria-hidden="true">{emoji}</span>
            <span class="font-semibold text-gray-900 text-sm">{title}</span>
            <span class="text-gray-500 text-sm leading-relaxed">{description}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- ============================================================
         COMO SELECIONAMOS O CONTEÚDO
    ============================================================ -->
    <section class="mb-14" aria-labelledby="criterios-title">
      <h2 id="criterios-title" class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2">
        <span aria-hidden="true">🔍</span> Como selecionamos o conteúdo
      </h2>
      <p class="text-gray-600 text-sm mb-5 leading-relaxed">
        Todo recurso listado no EduConecta passa por uma avaliação manual com base nos seguintes critérios:
      </p>
      <ul class="flex flex-col gap-3" role="list">
        {selectionCriteria.map((criterion) => (
          <li class="flex items-start gap-3 text-sm text-gray-700">
            <span class="text-primary-500 font-bold mt-0.5 shrink-0" aria-hidden="true">✓</span>
            <span>{criterion}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- ============================================================
         COMO CONTRIBUIR
    ============================================================ -->
    <section class="mb-14" aria-labelledby="contribuir-title">
      <h2 id="contribuir-title" class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2">
        <span aria-hidden="true">🤝</span> Como contribuir
      </h2>
      <p class="text-gray-600 text-sm mb-5 leading-relaxed">
        O EduConecta é um projeto aberto e toda contribuição é bem-vinda.
        Você pode ajudar de várias formas:
      </p>
      <ul class="flex flex-col gap-3 mb-6" role="list">
        {contribute.map(({ emoji, action }) => (
          <li class="flex items-center gap-3 text-sm text-gray-700">
            <span aria-hidden="true">{emoji}</span>
            <span>{action}</span>
          </li>
        ))}
      </ul>

      <a
        href="https://github.com/educonecta/educonecta"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-gray-900 text-white text-sm font-semibold px-5 py-3 rounded-xl hover:bg-gray-700 transition-colors"
        aria-label="Contribuir com o EduConecta no GitHub (abre em nova aba)"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.73.083-.73 1.205.085 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12"/>
        </svg>
        Contribuir no GitHub
      </a>
    </section>

    <!-- ============================================================
         AVISO LEGAL
    ============================================================ -->
    <section
      class="bg-yellow-50 border border-yellow-200 rounded-2xl p-5 text-sm text-yellow-800 leading-relaxed"
      aria-labelledby="aviso-title"
    >
      <h2 id="aviso-title" class="font-semibold mb-2 flex items-center gap-2">
        <span aria-hidden="true">⚠️</span> Aviso importante
      </h2>
      <p>
        O EduConecta <strong>não possui vínculo oficial</strong> com nenhuma das plataformas, canais
        ou instituições listadas. Somos um projeto independente de curadoria.
        Os links externos estão sujeitos a mudanças fora do nosso controle.
        Se encontrar algum link quebrado ou conteúdo inadequado,
        <a href="https://github.com/educonecta/educonecta/issues" target="_blank" rel="noopener noreferrer" class="underline font-medium">
          abra uma issue no GitHub
        </a>.
      </p>
    </section>

  </div>
</BaseLayout>
