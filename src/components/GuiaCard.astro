---
interface Props {
  slug:        string;
  title:       string;
  description: string;
  pubDate:     Date;
  category:    string;
  tags:        string[];
  readingTime?: number;
  featured?:   boolean;
}

const { slug, title, description, pubDate, category, tags, readingTime, featured } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const categoryConfig: Record<string, { label: string; class: string }> = {
  educacao:   { label: 'Educação',   class: 'bg-blue-100 text-blue-700' },
  tecnologia: { label: 'Tecnologia', class: 'bg-green-100 text-green-700' },
  dicas:      { label: 'Dicas',      class: 'bg-yellow-100 text-yellow-700' },
};

const cat = categoryConfig[category] ?? { label: category, class: 'bg-gray-100 text-gray-700' };

const formattedDate = pubDate.toLocaleDateString('pt-BR', {
  day: '2-digit', month: 'long', year: 'numeric',
});
---

<a
  href={`${base}/guias/${slug}`}
  class:list={[
    'group flex flex-col gap-3 p-5 bg-white border rounded-2xl hover:shadow-md transition-all',
    featured ? 'border-primary-300 ring-1 ring-primary-200' : 'border-gray-200 hover:border-primary-300',
  ]}
>
  <div class="flex items-center justify-between gap-2 flex-wrap">
    <span class:list={['text-xs font-medium px-2 py-0.5 rounded-full', cat.class]}>
      {cat.label}
    </span>
    {featured && (
      <span class="text-xs font-medium text-primary-600 bg-primary-50 px-2 py-0.5 rounded-full">
        ⭐ Destaque
      </span>
    )}
  </div>

  <div>
    <h2 class="text-base font-semibold text-gray-900 group-hover:text-primary-700 transition-colors leading-snug mb-1">
      {title}
    </h2>
    <p class="text-sm text-gray-500 leading-relaxed line-clamp-2">{description}</p>
  </div>

  <div class="flex items-center gap-3 text-xs text-gray-400 mt-auto pt-2 border-t border-gray-100">
    <time datetime={pubDate.toISOString()}>{formattedDate}</time>
    {readingTime && (
      <span>· {readingTime} min de leitura</span>
    )}
  </div>

  {tags.length > 0 && (
    <div class="flex flex-wrap gap-1.5">
      {tags.map((tag) => (
        <span class="text-xs text-gray-400 bg-gray-50 border border-gray-100 px-2 py-0.5 rounded-full">
          #{tag}
        </span>
      ))}
    </div>
  )}
</a>
